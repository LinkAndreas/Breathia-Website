# HTTPS in front of the website container. Caddy obtains and renews the certificate for
# {$DOMAIN} automatically; the domain's DNS A/AAAA records must point to this VPS.
{$DOMAIN} {
	encode zstd gzip

	# Directory URLs without a trailing slash (e.g. /privacy/en, as linked from the app) get one
	# here, so the redirect keeps the public host instead of the container's port.
	@noSlash {
		not path */
		not path_regexp \.[a-zA-Z0-9]+$
	}
	redir @noSlash {path}/ 308

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Vite's hashed bundles never change; pages always revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@images path *.webp *.png *.svg
	header @images Cache-Control "public, max-age=604800"
	@pages path / */ *.html
	header @pages Cache-Control "no-cache"

	reverse_proxy web:8080
}

# Redirect the www variant to the main domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
